# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# Postgres with the pgvector extension
DATABASE_URL=postgres://notes:notes@localhost:5432/notes

# Which notes to index. Defaults to the public sample corpus.
# Point this at your private notes folder (keep it outside the repo, or in ./notes which is git-ignored).
NOTES_DIR=./corpus/sample

# Embedder: "transformers" (local Xenova/bge-small-en-v1.5, downloads ~35MB once)
#           "hash" (feature hashing, no download, weaker, fully deterministic)
EMBEDDER=transformers

# Re-ranker: "cross-encoder" (local Xenova/ms-marco-MiniLM-L-6-v2), "heuristic", or "none"
RERANKER=cross-encoder

# Models
ANSWER_MODEL=claude-sonnet-5-5
ROUTER_MODEL=claude-haiku-5-5

# "anthropic" (real Claude) or "offline" (extractive baseline, no API calls; for demos and CI without a key)
LLM_PROVIDER=anthropic

PORT=8787
